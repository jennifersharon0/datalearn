
# Fichier : .env.example
#
# Modèle du fichier .env du backend. Copie ce fichier sous le nom ".env",
# puis remplace chaque valeur par la tienne. Le vrai .env ne doit jamais
# être publié (il est listé dans .gitignore).

# Clé de l'API Groq (console.groq.com > API Keys).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : force un modèle précis si celui par défaut a atteint son quota.
# GROQ_MODELE_FORCE=llama-3.1-8b-instant

# Adresse du projet Supabase (Project Settings > API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Connexion à la base PostgreSQL de Supabase (bouton "Connect" >
# Session pooler). Contient le mot de passe de la base : à garder secret.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Adresse du frontend, seule autorisée à appeler l'API (CORS).
# En local : http://localhost:5173. En ligne : l'adresse Vercel du site.
FRONTEND_URL=http://localhost:5173
